generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One shopee_order_id can span multiple rows on the real sheet — one row per
// product/variant line within the order (confirmed against live data: two
// rows, same order id, different category — "cao su trắng (cặp)" vs "cao su
// đen (cặp)"). categoryName is therefore part of the row's identity, not just
// descriptive data: uniqueness (and the sync diff key) is scoped to the pair.
model Order {
  id                   Int       @id @default(autoincrement())
  shopeeOrderId        String    @map("shopee_order_id")
  packageCode          String?   @map("package_code")
  orderDate            DateTime? @map("order_date")
  status               String
  trackingCode         String?   @map("tracking_code")
  carrier              String?
  deliveryMethod       String?   @map("delivery_method")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  orderQuantity        Int?      @map("order_quantity")
  productName          String?   @map("product_name")
  categoryName         String?   @map("category_name")
  lineQuantity         Int?      @map("line_quantity")
  rawRowHash           String    @map("raw_row_hash")
  sheetRowIndex        Int       @map("sheet_row_index")
  isActive             Boolean   @default(true) @map("is_active")
  deletedAt            DateTime? @map("deleted_at")
  firstSyncedAt        DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt         DateTime  @updatedAt @map("last_synced_at")

  // A stand-in row created by applyWaybillConfirmation (lib/zalo/poller.ts)
  // for an order the waybill PDF names that hasn't synced in from the main
  // Shopee sheet yet — only shopeeOrderId/trackingCode/status="Chưa đồng bộ"
  // are real, categoryName is "" since the PDF has no line-item breakdown.
  // applyOrdersPayload (lib/sync/apply.ts) deletes it and re-creates the
  // real line(s) once that order actually syncs in, carrying every
  // operational field below forward first so nothing typed in RowEditor (or
  // set by the Zalo confirmation itself) gets lost in the swap.
  isPlaceholder        Boolean   @default(false) @map("is_placeholder")

  // Below: operational fields Luân fills in by hand (the "LUÂN CẦN" report
  // columns that aren't derivable from any synced sheet) — edited in-app.
  // sentAt/sendStatus are also written by the Zalo poller (lib/zalo/poller.ts);
  // cancelReceivedAt/defectRate/cancelReceiptStatus are also written by the
  // cancel_receipt sync (applyCancelReceiptPayload) from "MII dữ liệu đối
  // soát Luân up" → "ĐƠN HUỶ" — both stay editable here as a manual override.
  sentAt               DateTime?            @map("sent_at")
  sendStatus           OrderSendStatus?     @map("send_status")
  paidAt               DateTime?            @map("paid_at")
  // Date Luân's warehouse physically received the returned/cancelled goods
  // back — distinct from Cancellation.cancelledAt, which is when Shopee's
  // own system processed the cancellation.
  cancelReceivedAt     DateTime?            @map("cancel_received_at")
  defectRate           Float?               @map("defect_rate")
  cancelReceiptStatus  CancelReceiptStatus? @map("cancel_receipt_status")
  cancelComplaintNote  String?              @map("cancel_complaint_note")
  note                 String?
  luanCheck            Boolean              @default(false) @map("luan_check")

  // Manual override for the auto-computed "amountPaid" (số tiền đối soát)
  // used in Report's payment-match calculation — set via RowEditor when the
  // PaymentRecord sync amount is wrong for this order/line. When set, this
  // replaces the synced PaymentRecord amount in buildReportRows, so
  // "trạng thái đối soát" (paymentMatch) is recomputed from this value
  // against amountDue using the same ±2% rule, rather than being its own
  // separately editable field.
  paidAmountOverride   Float?               @map("paid_amount_override")

  @@unique([shopeeOrderId, categoryName])
  @@map("orders")
}

// Same one-row-per-product-line shape as Order — see the comment there.
model DeliveredOrder {
  id                 Int       @id @default(autoincrement())
  shopeeOrderId      String    @map("shopee_order_id")
  packageCode        String?   @map("package_code")
  orderDate          DateTime? @map("order_date")
  status             String
  trackingCode       String?   @map("tracking_code")
  carrier            String?
  deliveredAt        DateTime? @map("delivered_at")
  completedAt        DateTime? @map("completed_at")
  returnRefundStatus String?   @map("return_refund_status")
  productName        String?   @map("product_name")
  warehouseName      String?   @map("warehouse_name")
  categoryName       String?   @map("category_name")
  rawRowHash         String    @map("raw_row_hash")
  sheetRowIndex      Int       @map("sheet_row_index")
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at")
  firstSyncedAt      DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt       DateTime  @updatedAt @map("last_synced_at")

  @@unique([shopeeOrderId, categoryName])
  @@map("delivered_orders")
}

enum CancellationType {
  cancelled
  delivery_failed
  returned_refunded
}

enum OrderSendStatus {
  sent
  cancelled
}

enum CancelReceiptStatus {
  received_full
  not_received
  received_partial
  // "Không cần nhận" — manual-only value (not in Luân's sheet dropdown),
  // set via RowEditor for orders where the returned goods don't need to
  // come back to the warehouse at all.
  not_needed
}

model Cancellation {
  id                   Int              @id @default(autoincrement())
  shopeeOrderId        String           @map("shopee_order_id")
  type                 CancellationType
  packageCode          String?          @map("package_code")
  orderDate            DateTime?        @map("order_date")
  status               String?
  buyerNote            String?          @map("buyer_note")
  trackingCode         String?          @map("tracking_code")
  carrier              String?
  expectedDeliveryDate DateTime?        @map("expected_delivery_date")
  deliveredAt          DateTime?        @map("delivered_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  productName          String?          @map("product_name")
  warehouseName        String?          @map("warehouse_name")
  categoryName         String?          @map("category_name")
  // Line quantity ("Số lượng") — distinct from returnedQuantity below
  // ("Số lượng sản phẩm được hoàn trả" / "Số lượng Hoàn"), which is how many
  // of that quantity actually came back.
  lineQuantity         Int?             @map("line_quantity")
  returnedQuantity     Int?             @map("returned_quantity")
  returnRefundStatus   String?          @map("return_refund_status")
  // "NCC note" (4.1/4.2) — the supplier/dropship partner's own note,
  // distinct from "Note" (shopeeNote below) which is Shopee/internal's.
  supplierNote         String?          @map("supplier_note")
  // "Note" (4.1/4.2) — Shopee/internal's note, distinct from supplierNote
  // above. Named to avoid colliding with Order.note, which is Luân's own
  // manually-typed note and an unrelated concept.
  shopeeNote           String?          @map("shopee_note")
  // "5. Trả hàng/hoàn tiền" only — its own complaint/refund workflow, not
  // present on the other two cancellation-family tabs. Synced now so it's
  // available once the dashboard needs it; no UI reads these yet.
  complaintId          String?          @map("complaint_id")
  buyerName            String?          @map("buyer_name")
  sku                  String?
  unitPrice            Float?           @map("unit_price")
  complaintAt          DateTime?        @map("complaint_at")
  fullOrderReturn      String?          @map("full_order_return")
  returnMethod         String?          @map("return_method")
  returnReason         String?          @map("return_reason")
  // "Lí Do Khiếu Nại" — the complaint reason, distinct from returnReason
  // above ("Lí do Trả hàng/Hoàn tiền", the return reason itself).
  complaintReason      String?          @map("complaint_reason")
  // "Người Bán cần phản hồi trước" — the deadline for Luân to respond to
  // the buyer's complaint.
  respondByAt          DateTime?        @map("respond_by_at")
  refundAmount         Float?           @map("refund_amount")
  refundedAt           DateTime?        @map("refunded_at")
  returnCarrier        String?          @map("return_carrier")
  returnTrackingCode   String?          @map("return_tracking_code")
  returnStatus         String?          @map("return_status")
  returnCompletedAt    DateTime?        @map("return_completed_at")
  totalValue           Float?           @map("total_value")
  complaintStatus      String?          @map("complaint_status")
  rawRowHash           String           @map("raw_row_hash")
  sheetRowIndex        Int              @map("sheet_row_index")
  isActive             Boolean          @default(true) @map("is_active")
  deletedAt            DateTime?        @map("deleted_at")
  firstSyncedAt        DateTime         @default(now()) @map("first_synced_at")
  lastSyncedAt         DateTime         @updatedAt @map("last_synced_at")

  // Set once the "overdue, still unresolved" Zalo warning has been sent for
  // this row (see lib/cancellation/overdueWarnings.ts) — null means not
  // sent yet. Only gates the Zalo message, not the web banner, which always
  // shows every currently-overdue row regardless of this flag.
  overdueWarnedAt      DateTime?        @map("overdue_warned_at")

  @@unique([shopeeOrderId, type])
  @@map("cancellations")
}

model Product {
  id            Int       @id @default(autoincrement())
  sku           String    @unique
  productName   String    @map("product_name")
  categoryName  String?   @map("category_name")
  parentSku     String?   @map("parent_sku")
  importPrice   Float     @map("import_price")
  // Patched in from a separate workbook ("MII dữ liệu đối soát Luân up" →
  // "THÔNG TIN HÀNG HOÁ"), keyed by the same sku — that sync is update-only
  // (see applySkuPricingPayload) and never creates a Product row on its own.
  kiotCode      String?   @map("kiot_code")
  collectPrice  Float?    @map("collect_price")
  rawRowHash    String    @map("raw_row_hash")
  sheetRowIndex Int       @map("sheet_row_index")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  firstSyncedAt DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt  DateTime  @updatedAt @map("last_synced_at")

  @@map("products")
}

enum SourceTab {
  orders
  delivered_orders
  cancelled
  delivery_failed
  returned_refunded
  products
  sku_pricing
  payment
  payment_batch
  cancel_receipt
}

// Synced from a third, separate Drive file — a weekly Shopee settlement
// report ("[MII-Furniture]- PAYMENT-..."), view-only access. One row per
// order: the Apps Script sums "Giá trị còn lại" across every weekly tab
// (each week is its own sheet in that file) before sending, since the sheet
// itself has one row per product line, not per order. Upsert-only, no
// soft-delete — a week disappearing from the payload should never erase a
// previously-synced payment.
// Keyed by (shopeeOrderId, sku) — NOT shopeeOrderId alone. A multi-line
// order has one payment row per product line in the settlement file (same
// column as the Report page's "SKU"); summing every line of an order into
// one total mis-compares a single line's amountDue against the whole
// order's amountPaid. Sums only within the same (order, sku) pair — a SKU
// that appears more than once for an order across different weekly tabs
// (e.g. a correction) is still totalled together, just not across SKUs.
model PaymentRecord {
  id            Int      @id @default(autoincrement())
  shopeeOrderId String   @map("shopee_order_id")
  sku           String
  amount        Float
  rawRowHash    String   @map("raw_row_hash")
  firstSyncedAt DateTime @default(now()) @map("first_synced_at")
  lastSyncedAt  DateTime @updatedAt @map("last_synced_at")

  @@unique([shopeeOrderId, sku])
  @@map("payment_records")
}

// One row per weekly tab in the same payment settlement file — lets the
// Reconciliation page browse the raw per-line data (Mã sản phẩm, Giá bán,
// Phí dịch vụ...) week by week, same names as the sheet's own tabs. Fully
// replaced on every sync (delete-then-recreate its lines), independent of
// PaymentRecord's cross-week aggregate above — kept separate so the
// already-working Report page amount sync isn't touched by this.
model PaymentBatch {
  id        Int                @id @default(autoincrement())
  weekLabel String             @unique @map("week_label")
  syncedAt  DateTime           @default(now()) @map("synced_at")
  lines     PaymentBatchLine[]

  @@map("payment_batches")
}

model PaymentBatchLine {
  id            Int          @id @default(autoincrement())
  batchId       Int          @map("batch_id")
  batch         PaymentBatch @relation(fields: [batchId], references: [id])
  shopeeOrderId String       @map("shopee_order_id")
  sku           String?
  productName   String?      @map("product_name")
  quantity      Int?
  sellPrice     Float?       @map("sell_price")
  serviceFee    Float?       @map("service_fee")
  taxDeduction  Float?       @map("tax_deduction")
  netAmount     Float        @map("net_amount")
  sheetRowIndex Int          @map("sheet_row_index")
  rawRowHash    String       @map("raw_row_hash")

  @@map("payment_batch_lines")
}

enum ChangeType {
  insert
  update
  delete
}

model SyncLog {
  id            Int        @id @default(autoincrement())
  sourceTab     SourceTab  @map("source_tab")
  sheetRowIndex Int        @map("sheet_row_index")
  changeType    ChangeType @map("change_type")
  oldValue      Json?      @map("old_value")
  newValue      Json?      @map("new_value")
  syncedAt      DateTime   @default(now()) @map("synced_at")

  @@map("sync_log")
}

enum BatchStatus {
  processing
  done
  error
}

model ReconciliationBatch {
  id          Int                    @id @default(autoincrement())
  fileName    String                 @map("file_name")
  uploadedAt  DateTime               @default(now()) @map("uploaded_at")
  periodLabel String?                @map("period_label")
  status      BatchStatus            @default(processing)
  results     ReconciliationResult[]

  @@map("reconciliation_batches")
}

enum MatchStatus {
  matched
  missing_in_sheet
  missing_in_excel
  status_mismatch
  parse_error
}

model ReconciliationResult {
  id            Int                 @id @default(autoincrement())
  batchId       Int                 @map("batch_id")
  batch         ReconciliationBatch @relation(fields: [batchId], references: [id])
  shopeeOrderId String?             @map("shopee_order_id")
  matchStatus   MatchStatus         @map("match_status")
  sheetAmount   Float?              @map("sheet_amount")
  excelAmount   Float?              @map("excel_amount")
  diffDetail    Json?               @map("diff_detail")

  @@map("reconciliation_results")
}

// One row per independent thing the background poller watches a Zalo group
// for — keyed by `purpose` (a fixed literal like "waybill_confirm" or
// "cancel_receipt_confirm"), not a singleton anymore now that there's more
// than one. lastProcessedMsgId is the since_msg_id cursor for that
// purpose's next /messages poll; pendingPdfUrl/pendingPdfMsgId are specific
// to "waybill_confirm" (see lib/zalo/poller.ts) — they track a waybill-PDF
// link message seen but not yet confirmed by staff, since the Zalo bridge
// has no reply-chain info. Left null and unused by every other purpose.
model ZaloWatchConfig {
  purpose            String   @id
  threadId           String   @map("thread_id")
  threadType         String   @map("thread_type")
  threadName         String   @map("thread_name")
  lastProcessedMsgId String?  @map("last_processed_msg_id")
  pendingPdfUrl      String?  @map("pending_pdf_url")
  pendingPdfMsgId    String?  @map("pending_pdf_msg_id")
  // Labels per A4 sheet (2, 4, 6 or 9) of the re-ordered PDF posted to this thread;
  // null keeps the layout of the PDF that was sent. Only the waybill flow reads it.
  waybillPerPage     Int?     @map("waybill_per_page")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("zalo_watch_config")
}

// Audit trail: one row per "đã đóng"/"Đã in ..." waybill confirmation the
// poller acted on, so Luân can verify what got auto-applied to orders and
// when. Purpose "waybill_confirm" only — see ZaloCancelReceiptLog for the
// "cancel_receipt_confirm" group's own log.
model ZaloConfirmationLog {
  id              Int      @id @default(autoincrement())
  threadId        String   @map("thread_id")
  pdfUrl          String   @map("pdf_url")
  orderIds        Json     @map("order_ids")
  matchedCount    Int      @map("matched_count")
  confirmedByName String?  @map("confirmed_by_name")
  confirmedAt     DateTime @default(now()) @map("confirmed_at")
  // Absent for rows logged before the grouped-Excel feature existed.
  file            WaybillFile?

  @@map("zalo_confirmation_logs")
}

// The grouped Excel generated for a waybill confirmation (lib/waybill), and —
// only when the PDF was uploaded by hand — the PDF itself, since an upload has
// no URL to open later (a pasted/Zalo link stays reachable at its own URL, so
// its PDF isn't copied here). Kept in Postgres as bytea: a few dozen KB per
// Excel, ~0.5 MB per uploaded PDF, and it needs no extra volume in Docker.
model WaybillFile {
  confirmationLogId Int                 @id @map("confirmation_log_id")
  xlsxName          String              @map("xlsx_name")
  xlsxData          Bytes               @map("xlsx_data")
  pdfName           String?             @map("pdf_name")
  pdfData           Bytes?              @map("pdf_data")
  // The source PDF's pages re-ordered exactly like the Excel rows. Null when the
  // PDF couldn't be re-ordered, and for rows from before this existed.
  sortedPdfName     String?             @map("sorted_pdf_name")
  sortedPdfData     Bytes?              @map("sorted_pdf_data")
  createdAt         DateTime            @default(now()) @map("created_at")
  log               ZaloConfirmationLog @relation(fields: [confirmationLogId], references: [id], onDelete: Cascade)

  @@map("waybill_files")
}

// Audit trail for the "cancel_receipt_confirm" Zalo group (lib/zalo/
// cancelReceiptPoller.ts) — any message in that group naming an order id
// and/or tracking code means the returned goods were received, dated to
// when the message itself was sent (not processing time), unlike the
// waybill-confirm flow.
model ZaloCancelReceiptLog {
  id              Int      @id @default(autoincrement())
  threadId        String   @map("thread_id")
  messageContent  String   @map("message_content")
  codes           Json
  matchedCount    Int      @map("matched_count")
  confirmedByName String?  @map("confirmed_by_name")
  confirmedAt     DateTime @map("confirmed_at")

  @@map("zalo_cancel_receipt_logs")
}

// Remembers the last-applied row hash per tracking code from the "ĐƠN HUỶ"
// cancel-receipt sync, so a 30-minute re-sync of the sheet's unchanged rows
// is a no-op instead of re-writing the same values (and silently clobbering
// a manual edit Luân made in RowEditor since the last real sheet change).
//
// Also remembers which shopeeOrderId the tracking code resolved to — a
// tracking code getting reassigned to a different order (carrier code
// reuse, or the 1-order-1-tracking-code assumption breaking) must force a
// re-apply even if the sheet row's own text is unchanged, since the
// resolved order changed underneath it. See applyCancelReceiptPayload.
model CancelReceiptSyncState {
  trackingCode  String   @id @map("tracking_code")
  shopeeOrderId String   @map("shopee_order_id")
  rawRowHash    String   @map("raw_row_hash")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("cancel_receipt_sync_state")
}

// Dashboard login accounts. Flat on purpose — every account can manage every
// other account, no roles (see docs/superpowers/specs/2026-10-07-account-management-design.md).
// `username` is always stored lower-cased so uniqueness is case-insensitive.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
