generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One shopee_order_id can span multiple rows on the real sheet — one row per
// product/variant line within the order (confirmed against live data: two
// rows, same order id, different category — "cao su trắng (cặp)" vs "cao su
// đen (cặp)"). categoryName is therefore part of the row's identity, not just
// descriptive data: uniqueness (and the sync diff key) is scoped to the pair.
model Order {
  id                   Int       @id @default(autoincrement())
  shopeeOrderId        String    @map("shopee_order_id")
  packageCode          String?   @map("package_code")
  orderDate            DateTime? @map("order_date")
  status               String
  trackingCode         String?   @map("tracking_code")
  carrier              String?
  deliveryMethod       String?   @map("delivery_method")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  orderQuantity        Int?      @map("order_quantity")
  productName          String?   @map("product_name")
  categoryName         String?   @map("category_name")
  lineQuantity         Int?      @map("line_quantity")
  rawRowHash           String    @map("raw_row_hash")
  sheetRowIndex        Int       @map("sheet_row_index")
  isActive             Boolean   @default(true) @map("is_active")
  deletedAt            DateTime? @map("deleted_at")
  firstSyncedAt        DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt         DateTime  @updatedAt @map("last_synced_at")

  // Below: operational fields Luân fills in by hand (the "LUÂN CẦN" report
  // columns that aren't derivable from any synced sheet) — edited in-app,
  // never written by the sync webhook.
  sentAt               DateTime?            @map("sent_at")
  sendStatus           OrderSendStatus?     @map("send_status")
  paidAt               DateTime?            @map("paid_at")
  defectRate           Float?               @map("defect_rate")
  cancelReceiptStatus  CancelReceiptStatus? @map("cancel_receipt_status")
  cancelComplaintNote  String?              @map("cancel_complaint_note")
  note                 String?
  luanCheck            Boolean              @default(false) @map("luan_check")

  @@unique([shopeeOrderId, categoryName])
  @@map("orders")
}

// Same one-row-per-product-line shape as Order — see the comment there.
model DeliveredOrder {
  id                 Int       @id @default(autoincrement())
  shopeeOrderId      String    @map("shopee_order_id")
  packageCode        String?   @map("package_code")
  orderDate          DateTime? @map("order_date")
  status             String
  trackingCode       String?   @map("tracking_code")
  carrier            String?
  deliveredAt        DateTime? @map("delivered_at")
  completedAt        DateTime? @map("completed_at")
  returnRefundStatus String?   @map("return_refund_status")
  productName        String?   @map("product_name")
  warehouseName      String?   @map("warehouse_name")
  categoryName       String?   @map("category_name")
  rawRowHash         String    @map("raw_row_hash")
  sheetRowIndex      Int       @map("sheet_row_index")
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at")
  firstSyncedAt      DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt       DateTime  @updatedAt @map("last_synced_at")

  @@unique([shopeeOrderId, categoryName])
  @@map("delivered_orders")
}

enum CancellationType {
  cancelled
  delivery_failed
  returned_refunded
}

enum OrderSendStatus {
  sent
  cancelled
}

enum CancelReceiptStatus {
  received_full
  not_received
  received_partial
}

model Cancellation {
  id                   Int              @id @default(autoincrement())
  shopeeOrderId        String           @map("shopee_order_id")
  type                 CancellationType
  packageCode          String?          @map("package_code")
  orderDate            DateTime?        @map("order_date")
  status               String?
  buyerNote            String?          @map("buyer_note")
  trackingCode         String?          @map("tracking_code")
  carrier              String?
  expectedDeliveryDate DateTime?        @map("expected_delivery_date")
  deliveredAt          DateTime?        @map("delivered_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  productName          String?          @map("product_name")
  warehouseName        String?          @map("warehouse_name")
  categoryName         String?          @map("category_name")
  returnedQuantity     Int?             @map("returned_quantity")
  returnRefundStatus   String?          @map("return_refund_status")
  // "5. Trả hàng/hoàn tiền" only — its own complaint/refund workflow, not
  // present on the other two cancellation-family tabs. Synced now so it's
  // available once the dashboard needs it; no UI reads these yet.
  complaintId          String?          @map("complaint_id")
  buyerName            String?          @map("buyer_name")
  sku                  String?
  unitPrice            Float?           @map("unit_price")
  complaintAt          DateTime?        @map("complaint_at")
  fullOrderReturn      String?          @map("full_order_return")
  returnMethod         String?          @map("return_method")
  returnReason         String?          @map("return_reason")
  refundAmount         Float?           @map("refund_amount")
  refundedAt           DateTime?        @map("refunded_at")
  returnCarrier        String?          @map("return_carrier")
  returnTrackingCode   String?          @map("return_tracking_code")
  returnStatus         String?          @map("return_status")
  returnCompletedAt    DateTime?        @map("return_completed_at")
  totalValue           Float?           @map("total_value")
  complaintStatus      String?          @map("complaint_status")
  rawRowHash           String           @map("raw_row_hash")
  sheetRowIndex        Int              @map("sheet_row_index")
  isActive             Boolean          @default(true) @map("is_active")
  deletedAt            DateTime?        @map("deleted_at")
  firstSyncedAt        DateTime         @default(now()) @map("first_synced_at")
  lastSyncedAt         DateTime         @updatedAt @map("last_synced_at")

  @@unique([shopeeOrderId, type])
  @@map("cancellations")
}

model Product {
  id            Int       @id @default(autoincrement())
  sku           String    @unique
  productName   String    @map("product_name")
  categoryName  String?   @map("category_name")
  parentSku     String?   @map("parent_sku")
  importPrice   Float     @map("import_price")
  // Patched in from a separate workbook ("MII dữ liệu đối soát Luân up" →
  // "THÔNG TIN HÀNG HOÁ"), keyed by the same sku — that sync is update-only
  // (see applySkuPricingPayload) and never creates a Product row on its own.
  kiotCode      String?   @map("kiot_code")
  collectPrice  Float?    @map("collect_price")
  rawRowHash    String    @map("raw_row_hash")
  sheetRowIndex Int       @map("sheet_row_index")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  firstSyncedAt DateTime  @default(now()) @map("first_synced_at")
  lastSyncedAt  DateTime  @updatedAt @map("last_synced_at")

  @@map("products")
}

enum SourceTab {
  orders
  delivered_orders
  cancelled
  delivery_failed
  returned_refunded
  products
  sku_pricing
  payment
}

// Synced from a third, separate Drive file — a weekly Shopee settlement
// report ("[MII-Furniture]- PAYMENT-..."), view-only access. One row per
// order: the Apps Script sums "Giá trị còn lại" across every weekly tab
// (each week is its own sheet in that file) before sending, since the sheet
// itself has one row per product line, not per order. Upsert-only, no
// soft-delete — a week disappearing from the payload should never erase a
// previously-synced payment.
model PaymentRecord {
  id            Int      @id @default(autoincrement())
  shopeeOrderId String   @unique @map("shopee_order_id")
  amount        Float
  rawRowHash    String   @map("raw_row_hash")
  firstSyncedAt DateTime @default(now()) @map("first_synced_at")
  lastSyncedAt  DateTime @updatedAt @map("last_synced_at")

  @@map("payment_records")
}

enum ChangeType {
  insert
  update
  delete
}

model SyncLog {
  id            Int        @id @default(autoincrement())
  sourceTab     SourceTab  @map("source_tab")
  sheetRowIndex Int        @map("sheet_row_index")
  changeType    ChangeType @map("change_type")
  oldValue      Json?      @map("old_value")
  newValue      Json?      @map("new_value")
  syncedAt      DateTime   @default(now()) @map("synced_at")

  @@map("sync_log")
}

enum BatchStatus {
  processing
  done
  error
}

model ReconciliationBatch {
  id          Int                    @id @default(autoincrement())
  fileName    String                 @map("file_name")
  uploadedAt  DateTime               @default(now()) @map("uploaded_at")
  periodLabel String?                @map("period_label")
  status      BatchStatus            @default(processing)
  results     ReconciliationResult[]

  @@map("reconciliation_batches")
}

enum MatchStatus {
  matched
  missing_in_sheet
  missing_in_excel
  status_mismatch
  parse_error
}

model ReconciliationResult {
  id            Int                 @id @default(autoincrement())
  batchId       Int                 @map("batch_id")
  batch         ReconciliationBatch @relation(fields: [batchId], references: [id])
  shopeeOrderId String?             @map("shopee_order_id")
  matchStatus   MatchStatus         @map("match_status")
  sheetAmount   Float?              @map("sheet_amount")
  excelAmount   Float?              @map("excel_amount")
  diffDetail    Json?               @map("diff_detail")

  @@map("reconciliation_results")
}
