DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopee_reconciliation"
SYNC_WEBHOOK_SECRET="change-me"
# Gates the dashboard + upload/edit APIs with HTTP Basic Auth. Leave unset in
# local dev (auth fails open with no credentials configured) — always set
# both in any deployed environment.
DASHBOARD_USER="change-me"
DASHBOARD_PASSWORD="change-me"
# Zalo bridge (separate service — see /dashboard/zalo). Leave unset if the
# Zalo watch feature isn't configured yet; the poller no-ops with no thread
# selected regardless.
ZALO_BRIDGE_URL="https://zalo.your-vps-domain.example"
ZALO_BRIDGE_SECRET="change-me"
