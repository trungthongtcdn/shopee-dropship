DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopee_reconciliation"
SYNC_WEBHOOK_SECRET="change-me"
# Signs the login session cookie (`openssl rand -hex 32`). REQUIRED in any
# deployed environment — without it production rejects every session and login
# fails. Rotating it logs everyone out (the emergency "revoke all sessions").
# Local dev falls back to a built-in insecure value when unset.
SESSION_SECRET="change-me"
# One-time bootstrap only: while the `users` table is empty, logging in with
# exactly this pair creates the first account. After any account exists these
# two are ignored — accounts are managed at /dashboard/accounts.
DASHBOARD_USER="change-me"
DASHBOARD_PASSWORD="change-me"
# Zalo bridge (separate service — see /dashboard/zalo). Leave unset if the
# Zalo watch feature isn't configured yet; the poller no-ops with no thread
# selected regardless.
ZALO_BRIDGE_URL="https://zalo.your-vps-domain.example"
ZALO_BRIDGE_SECRET="change-me"
