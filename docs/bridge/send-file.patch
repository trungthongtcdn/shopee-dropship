+/**
+ * Sends a file (e.g. the grouped .xlsx the shopee-dropship app builds) with a
+ * caption to a group or 1-1 thread. `data` is a Buffer already in memory — the
+ * API receives it as base64 — so nothing is written to disk.
+ * @param threadType 'user' | 'group'
+ */
+export async function sendFileByThreadId(threadType, threadId, filename, data, message) {
+  if (!api) {
+    throw new Error('Chưa đăng nhập Zalo — mở màn Cấu hình nhắc hẹn Zalo trong app để kết nối trước');
+  }
+  const numericType = threadType === 'group' ? ThreadType.Group : ThreadType.User;
+  await api.sendMessage(
+    {
+      // zca-js wants a text part alongside attachments; fall back to the file
+      // name so the message is never empty.
+      msg: message || filename,
+      attachments: [{ data, filename, metadata: { totalSize: data.length } }],
+    },
+    threadId,
+    numericType
+  );
+}
