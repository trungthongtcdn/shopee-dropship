+// Sends a file (base64 in JSON) to a group or 1-1 thread — used by the
+// shopee-dropship app to post the grouped order list (.xlsx) back into the
+// Zalo group a waybill PDF arrived in.
+app.post('/send-file', async (req, res) => {
+  if (!requireSecret(req, res)) return;
+  const {
+    thread_id: threadId,
+    thread_type: threadType,
+    filename,
+    file_base64: fileBase64,
+    message,
+  } = req.body ?? {};
+  if (
+    !threadId ||
+    !['user', 'group'].includes(threadType) ||
+    typeof fileBase64 !== 'string' ||
+    !fileBase64 ||
+    typeof filename !== 'string' ||
+    !/^[^/\\]+\.[A-Za-z0-9]+$/.test(filename)
+  ) {
+    return res.status(400).json({
+      error: 'thread_id, thread_type ("user"|"group"), filename (name.ext, no path) and file_base64 are required',
+    });
+  }
+  const data = Buffer.from(fileBase64, 'base64');
+  if (data.length === 0) {
+    return res.status(400).json({ error: 'file_base64 decoded to an empty file' });
+  }
+  try {
+    await sendFileByThreadId(threadType, threadId, filename, data, message);
+    res.json({ ok: true });
+  } catch (err) {
+    console.error('Gửi file Zalo thất bại:', err);
     res.status(500).json({ error: String(err.message ?? err) });
   }
 });
